# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Local/personal config & build output (do not publish)
projects.json
projects.real.json
/out

# Claude Code: settings.local.json is the per-machine override (enabled MCP
# servers, personal permission rules) and is personal by design. The shareable
# project-level file is .claude/settings.json, so only the local one is ignored.
.claude/settings.local.json

# File-dropper: dropped/pasted files land in <working dir>/input. When Taurus
# runs inside its own repo, that folder shows up here as a runtime artifact.
/input/

# White-label branding is a local config item — keep brands out of the repo.
# Real branding lives in %APPDATA%\Taurus\branding.json (+ a logo); these are
# only here in case someone keeps a copy in the working tree for testing.
branding.json
# Zonder pad-prefix: een merk-logo hoort ook naast de gebundelde resources
# (src-tauri/<merk>-logo.png), en dat pad viel eerder buiten de regel (#111).
*-logo.png
!src/taurus-logo.png
# Brand-specific Tauri config overlays (installer name/identifier) stay local.
src-tauri/tauri.*.conf.json
!src-tauri/tauri.conf.json

# Local demo / recording helpers (not part of the published app)
/demo/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
