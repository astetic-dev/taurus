<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime entitlements for the signed macOS build (#266).
     Only the microphone, for dictation (#231); without it macOS refuses the
     input device under the hardened runtime. Agents and the speech engine run
     as their own executables, so nothing else is needed here. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
